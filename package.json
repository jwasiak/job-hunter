{
  "name": "job-hunter",
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "author": "Jarosław Wasiak <dev@wasiak.biz>",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "build:watch": "tsc -w",
    "dev": "NODE_ENV='develomenent' nodemon",
    "start": "NODE_ENV='production' node dist/app.js",
    "migrate:up": "node -r dotenv/config ./node_modules/.bin/knex migrate:up",
    "migrate:down": "node -r dotenv/config ./node_modules/.bin/knex migrate:down",
    "seed:make": "node -r dotenv/config ./node_modules/.bin/knex seed:make",
    "seed:run": "node -r dotenv/config ./node_modules/.bin/knex seed:run",
    "clear:log": "node -r dotenv/config ./node_modules/.bin/knex seed:run --specific=logs.js"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.0",
    "@adminjs/import-export": "^3.0.0",
    "@adminjs/logger": "^5.0.1",
    "@adminjs/passwords": "^4.0.0",
    "@adminjs/typeorm": "^5.0.1",
    "@adminjs/upload": "^4.0.2",
    "adminjs": "^7.8.1",
    "argon2": "^0.40.3",
    "better-sqlite3": "^11.0.0",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-formidable": "^1.2.0",
    "express-session": "^1.18.0",
    "express-session-sqlite": "^2.1.1",
    "knex": "^3.1.0",
    "lodash": "^4.17.21",
    "nodemon": "^3.1.4",
    "pg": "^8.12.0",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.5",
    "@types/pg-pool": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.49.0",
    "eslint-plugin-react": "^7.34.3",
    "prettier": "3.3.2",
    "typescript": "^5.5.2"
  }
}
